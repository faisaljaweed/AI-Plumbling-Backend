# Database and business
DATABASE_URL=postgresql://user:password@host:5432/database
BUSINESS_ID=1
BUSINESS_TIMEZONE=America/Chicago
FRONTEND_URL=http://localhost:3000
PORT=5000
# Generate independent random secrets; match ADMIN_API_KEY with frontend API_ADMIN_KEY.
ADMIN_API_KEY=
CUSTOMER_TOKEN_SECRET=
# Gemini is optional: guided mode remains functional when quota is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MODE=auto
